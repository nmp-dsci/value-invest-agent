# Copy to ~/.env (the default the CLI loads) or ./.env and fill in your keys.
# Never commit a filled-in copy.

# --- Required ------------------------------------------------------------
SUPADATA_API_KEY=<your Supadata API key>          # channel listing, metadata, transcripts
ANTHROPIC_API_KEY=<your Anthropic API key>        # extraction + analyst agent (Claude)
# DEEPSEEK_API_KEY=<optional, for high-volume runs>

# --- transcript-lab (transcript-rag-agent) -------------------------------
# The transcripts and chunks live in the sibling project's Chroma store; this
# project reads them back by video_id / chunk id through its API.
TRANSCRIPT_LAB_API=http://127.0.0.1:8000
TRANSCRIPT_LAB_CHROMA_PATH=../transcript-rag-agent/.yt-agent/chroma

# --- Storage -------------------------------------------------------------
VI_DUCKDB_PATH=data/value_invest.duckdb
VI_CACHE_DIR=.vi

# --- Corpus --------------------------------------------------------------
VI_CHANNEL=@Value-Investing
VI_CHANNEL_ID=UCrTTBSUr0zhPU56UQljag5A
VI_SINCE=2022-09-17

# --- Validation ----------------------------------------------------------
VI_HORIZONS_MONTHS=6,12,24
VI_DEFAULT_BENCHMARK=SPY
VI_VERDICT_BAND_PP=5
