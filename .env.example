# Copy to ~/.env (the default the CLI loads) or ./.env and fill in your keys.
# Never commit a filled-in copy.

# --- Required ------------------------------------------------------------
SUPADATA_API_KEY=<your Supadata API key>          # channel listing, metadata, transcripts

# --- Billing (Claude Agent SDK) -----------------------------------------
# Dev runs bill the Claude subscription, as in ConvFinQA-agent and DABStep-loop:
# `claude setup-token` writes CLAUDE_CODE_OAUTH_TOKEN; llm.py blanks any
# ANTHROPIC_API_KEY and refuses to start if both a key and BILLING=subscription
# are set. The demo image has DEMO_MODE=1 baked in and cannot call a model.
BILLING=subscription
# CLAUDE_CODE_OAUTH_TOKEN=<from `claude setup-token`>
VI_MODEL=claude-sonnet-5              # model under test (agents/vN/agent.yaml pins it per version)
VI_OPTIMISER_MODEL=claude-opus-5      # the error-loop optimiser session

# --- transcript-lab (transcript-rag-agent) -------------------------------
# The transcripts and chunks live in the sibling project's Chroma store; this
# project reads them back by video_id / chunk id through its API.
TRANSCRIPT_LAB_API=http://127.0.0.1:8000
TRANSCRIPT_LAB_CHROMA_PATH=../transcript-rag-agent/.yt-agent/chroma

# --- Storage -------------------------------------------------------------
VI_DUCKDB_PATH=data/value_invest.duckdb
VI_CACHE_DIR=.vi

# --- Corpus --------------------------------------------------------------
VI_CHANNEL=@Value-Investing
VI_CHANNEL_ID=UCrTTBSUr0zhPU56UQljag5A
VI_SINCE=2022-09-17
VI_SAMPLE_PER_YEAR=10
VI_SAMPLE_SEED=42

# --- SEC EDGAR (10+ years of US statements with filing dates) --------------
# SEC's fair-access policy requires a contact in the User-Agent: "Name email".
SEC_USER_AGENT="Your Name you@example.com"

# --- Validation ----------------------------------------------------------
VI_HORIZONS_MONTHS=6,12,24
VI_DEFAULT_BENCHMARK=SPY
VI_VERDICT_BAND_PP=5

# --- M2 window (D12): 20 videos per window year over six years
# VI_SINCE=2020-09-17
# VI_SAMPLE_PER_YEAR=20
# VI_PRICES_FROM=2015-01-01     # 5 years before the earliest T0 for the Video chart
